# Aplicação e GBIF
PAIS_PADRAO=BR
ESPECIE_PADRAO=Oreochromis niloticus
LIMITE_CONSULTA_PADRAO=10000
LIMITE_REGISTROS_DASHBOARD=50000
TAMANHO_PAGINA_PADRAO=300
GRUPO_TAXONOMICO=Actinopterygii
GBIF_API=https://api.gbif.org/v1

# PostgreSQL local
POSTGRES_DB=biodiversidade_peixes
POSTGRES_USER=biodiversity_owner
POSTGRES_PASSWORD=change-owner-password
DATABASE_WRITE_URL=postgresql://biodiversity_owner:change-owner-password@localhost:5432/biodiversidade_peixes
DATABASE_URL=postgresql://biodiversity_app:change-readonly-password@localhost:5432/biodiversidade_peixes
DB_SCHEMA=biodiversity

# Banco exclusivo para testes de integração (opcional)
# TEST_DATABASE_URL=postgresql://biodiversity_owner:change-owner-password@localhost:5432/biodiversidade_peixes_test
