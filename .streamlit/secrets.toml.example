# Cole estas chaves em Advanced settings > Secrets no Streamlit Community Cloud.
# Use exclusivamente o papel PostgreSQL de leitura no dashboard público.
DATABASE_URL = "postgresql://biodiversity_app:change-readonly-password@remote-host:5432/biodiversidade_peixes?sslmode=require"
DB_SCHEMA = "biodiversity"
LIMITE_REGISTROS_DASHBOARD = 50000

# Não configure DATABASE_WRITE_URL na aplicação pública. Cargas e atualizações
# devem ser executadas em um ambiente administrativo separado.
